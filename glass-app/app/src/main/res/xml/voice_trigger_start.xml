<?xml version="1.0" encoding="utf-8"?>
<!--
  An unlisted (custom) voice trigger. Glass only accepts unlisted keywords when the app
  also requests com.google.android.glass.permission.DEVELOPMENT (declared in the
  manifest); otherwise the VoiceTriggers parser reports "Unable to build voice trigger".

  The keyword string is what appears in the "ok glass" voice menu and what the user says.
-->
<trigger keyword="@string/glass_voice_trigger" />
